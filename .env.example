# GoHighLevel Inbound Webhook URL (Workflows -> Add Trigger -> Inbound Webhook -> copy URL)
# Server-side only. If unset locally, submissions are logged and skipped instead of failing.
GHL_WEBHOOK_URL=

# GoHighLevel Private Integration Token (Settings -> Private Integrations -> Create new Integration)
# Scopes needed: Calendars, Calendars/Events, Contacts. Server-side only.
GHL_API_TOKEN=

# GoHighLevel sub-account/location ID.
GHL_LOCATION_ID=

# GoHighLevel calendar ID for the Rebuild Call calendar (the real API calendar
# id from GHL, not the DOM widget id used by the old embedded calendar).
GHL_CALENDAR_ID=

# Appointment duration in minutes. Must match the calendar's actual event
# length configured in GHL, since we compute each appointment's end time
# from this rather than trusting the client.
GHL_APPOINTMENT_DURATION_MINUTES=15

# Set to "true" during local/dev testing to skip real GHL contact/appointment
# creation and return a fake success instead. Never set this in production.
GHL_BOOKING_DRY_RUN=
